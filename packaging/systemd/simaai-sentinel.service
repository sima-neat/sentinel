[Unit]
Description=SiMa.ai Sentinel sensor monitoring daemon
After=multi-user.target

[Service]
Type=simple
# Board power comes from the kernel's PMBus driver. The device tree declares
# the regulators, but the module does not load on its own; a missing module
# leaves power unavailable with the reason in the cache, not a failed start.
ExecStartPre=-/sbin/modprobe irps5401
ExecStart=/usr/local/bin/simaai-sentinel daemon --cache /run/simaai-sentinel/cache.json --api-socket /run/simaai-sentinel/api.sock --interval 2.0 --history 240
Restart=always
RestartSec=5
User=root
Group=root
# Temperature controller ownership belongs to the kernel driver.
InaccessiblePaths=-/dev/mem
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
